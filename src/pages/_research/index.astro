---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { url } from '../../lib/url';

const all = await getProjects();
const projects = all.filter((p) => p.data.kind === 'project');
const sections = [
  { title: 'Research Areas', items: all.filter((p) => p.data.kind === 'area') },
  { title: 'Current Projects', items: projects.filter((p) => p.data.status === 'active') },
  { title: 'Past Projects', items: projects.filter((p) => p.data.status === 'past') },
].filter((s) => s.items.length > 0);
---

<Base title="Research">
  <section class="page-header">
    <div class="wrap">
      <h1>Research</h1>
      <p>
        We study how to build robots that act intelligently in large, uncertain, everyday environments, combining
        planning, learning, and perception. See <a href={url('publications/')}>Publications</a> for the full list of
        papers.
      </p>
    </div>
  </section>
  <section class="wrap" style="padding-bottom: 5rem">
    {sections.length === 0 && <p class="empty">Nothing here yet.</p>}
    {sections.map((s) => (
      <>
        <h2 class="slash-title">{s.title}</h2>
        <div class="projects">
          {s.items.map((p) => (
            <a class="project" href={url(`research/${p.id}/`)}>
              {p.data.cover ? <Image src={p.data.cover} alt="" width={600} class="cover" /> : <div class="cover blank" />}
              <h3>{p.data.title}{p.data.draft && ' (draft)'}</h3>
              <p>{p.data.summary}</p>
            </a>
          ))}
        </div>
      </>
    ))}
  </section>
</Base>

<style>
  h2 { margin-top: 1rem; }
  .projects { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2.5rem; margin-bottom: 3rem; }
  .project { color: var(--ink); font-weight: 400; text-decoration: none; }
  .project:hover { text-decoration: none; }
  .project:hover h3 { color: var(--purple); }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 1rem; }
  .blank { background: linear-gradient(135deg, var(--navy), var(--purple)); }
  h3 { margin-bottom: 0.5rem; font-size: 1.35rem; }
  p { font-size: 1rem; margin: 0; }
</style>
