---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AuthorList from '../../components/AuthorList.astro';
import { getPosts } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, cover, authors, external_authors, draft } = post.data;
---

<Base title={title} description={summary}>
  <article class="wrap-narrow post">
    <p class="meta">
      <a href={url('blog/')}>← Blog</a> ·
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      {draft && <strong> · DRAFT (not shown on the live site)</strong>}
    </p>
    <h1>{title}</h1>
    <p class="byline">By <AuthorList authors={authors} external={external_authors} /></p>
    {cover && <Image src={cover} alt="" width={1200} class="cover" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { padding-top: 9rem; padding-bottom: 5rem; }
  .post h1 { margin: 1rem 0; font-size: 2.6rem; }
  .byline { margin-bottom: 2rem; }
  .cover { margin-bottom: 2.5rem; width: 100%; }
  @media (max-width: 760px) {
    .post { padding-top: 5rem; }
    .post h1 { font-size: 2rem; }
  }
</style>
