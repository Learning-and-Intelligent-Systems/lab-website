---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Blog">
  <section class="page-header">
    <div class="wrap">
      <h1>Blog</h1>
      <p class="lede">Explainers, tutorials, and opinions from members of the LIS Group.</p>
    </div>
  </section>
  <section class="wrap" style="padding-bottom: 5rem">
    {posts.length > 0 ? posts.map((post) => <PostCard post={post} />) : <p class="empty">No posts yet.</p>}
  </section>
</Base>
