---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import { ROLES } from '../content.config';
import { byLastName } from '../lib/people';

const people = (await getCollection('people')).sort(byLastName);
const current = people.filter((p) => !p.data.alumni);
const alumni = people.filter((p) => p.data.alumni);
const pis = current.filter((p) => p.data.role === 'pi');

type Role = keyof typeof ROLES;
const groupOrder: Role[] = ['postdoc', 'phd', 'meng', 'urop', 'visiting', 'staff', 'other', 'pet'];
const groups = groupOrder
  .map((role) => ({ role, members: current.filter((p) => p.data.role === role) }))
  .filter((g) => g.members.length > 0);

const alumniLabels: Partial<Record<Role, string>> = {
  pi: 'Faculty Alumni',
  postdoc: 'Postdoctoral Alumni',
  phd: 'PhD Alumni',
  meng: 'MEng Alumni',
  urop: 'UROP Alumni',
  visiting: 'Visiting Alumni',
  staff: 'Staff Alumni',
  other: 'Other Alumni',
};
const alumniGroups = (Object.keys(alumniLabels) as Role[])
  .map((role) => ({ label: alumniLabels[role], members: alumni.filter((p) => p.data.role === role) }))
  .filter((g) => g.members.length > 0);
---

<Base title="People" description="The people behind the LIS Group.">
  <section class="page-header">
    <div class="wrap">
      <h1>Meet the Team</h1>
      <p class="lede">The people behind the LIS Group.</p>
    </div>
  </section>

  <section class="wrap people">
    <h2 class="slash-title">Principal Investigators</h2>
    <div class="pis">
      {pis.map(({ data }) => (
        <div class="pi">
          {data.photo && <a href={data.website}><Image src={data.photo} alt={data.name} width={400} height={400} fit="cover" /></a>}
          <div>
            <h3><a href={data.website}>{data.name}</a></h3>
            {data.title && <p>{data.title}</p>}
          </div>
        </div>
      ))}
    </div>

    {groups.map((g) => (
      <>
        <h2 class="slash-title">{ROLES[g.role]}</h2>
        <div class="grid">
          {g.members.map((person) => <PersonCard person={person} />)}
        </div>
      </>
    ))}

    <h2 class="slash-title">Alumni</h2>
    {alumniGroups.map((g) => (
      <>
        <h4>{g.label}</h4>
        <ul class="alumni">
          {g.members.map(({ data }) => (
            <li>{data.website ? <a href={data.website}>{data.name}</a> : data.name}</li>
          ))}
        </ul>
      </>
    ))}
  </section>
</Base>

<style>
  .people { padding-bottom: 5rem; }
  .people h2 { margin-top: 4rem; }
  .pis { display: flex; flex-wrap: wrap; gap: 2.5rem 4rem; }
  .pi { display: flex; align-items: center; gap: 1.5rem; flex: 1 1 min(380px, 100%); }
  .pi > a { flex: 0 0 200px; }
  .pi img { width: 200px; height: 200px; object-fit: cover; }
  .pi h3 { margin-bottom: 0.5rem; font-size: 1.4rem; }
  .pi p { margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 2.5rem 1.5rem; }
  h4 { margin: 2rem 0 0.75rem; }
  .alumni { list-style: none; columns: 4 200px; column-gap: 2rem; }
  .alumni li { font-size: 1rem; line-height: 1.9rem; break-inside: avoid; }
  .alumni a { font-weight: 400; }
  @media (max-width: 760px) {
    .pi { flex-direction: column; align-items: flex-start; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }
</style>
