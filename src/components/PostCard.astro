---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorList from './AuthorList.astro';
import { url } from '../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, date, summary, cover, authors, external_authors, draft } = post.data;
---

<article class="post">
  <div class="info">
    <p class="date">
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      {draft && <span class="draft">Draft</span>}
    </p>
    <h3><a href={url(`blog/${post.id}/`)}>{title}</a></h3>
    <p class="byline">Authors: <AuthorList authors={authors} external={external_authors} /></p>
    <p class="summary">{summary}</p>
  </div>
  {cover && <Image src={cover} alt="" width={480} class="cover" />}
</article>

<style>
  .post { display: flex; gap: 2.5rem; padding: 2.5rem 0; border-top: 1px solid #ccc; }
  .post:first-of-type { border-top: 0; }
  .info { flex: 1; }
  .date { color: var(--muted); font-size: 0.95rem; margin-bottom: 0.5rem; }
  h3 { font-size: 1.6rem; line-height: 1.3; margin-bottom: 0.75rem; }
  h3 a { color: var(--ink); }
  h3 a:hover { color: var(--purple); }
  .byline { font-size: 1rem; margin-bottom: 0.75rem; }
  .summary { margin: 0; }
  .cover { width: 320px; flex: 0 0 320px; align-self: center; }
  .draft { background: var(--purple); color: #fff; font-size: 0.75rem; padding: 2px 6px; margin-left: 0.5rem; text-transform: uppercase; }
  @media (max-width: 760px) {
    .post { flex-direction: column-reverse; gap: 1rem; }
    .cover { width: 100%; flex-basis: auto; }
  }
</style>
