---
import type { CollectionEntry } from 'astro:content';
import { findPerson, type Person } from '../lib/people';

interface Props {
  pub: CollectionEntry<'publications'>;
  people: Map<string, Person>;
}
const { pub, people } = Astro.props;
const { title, authors, venue, year, url: link, pdf, code, website, doi, note, links, bibtex } = pub.data;
const primary = link ?? pdf ?? website;
---

<li class="pub" id={pub.id}>
  <span class="title">{primary ? <a href={primary}>{title}</a> : title}</span>
  <span class="authors">
    {authors.map((a, i) => {
      const person = findPerson(people, a);
      const label = person?.data.website ? <a href={person.data.website}>{a}</a> : person ? <strong>{a}</strong> : a;
      return <>{label}{i < authors.length - 1 && ', '}</>;
    })}
  </span>
  <span class="venue">{venue}{venue && ', '}{year}.</span>
  {note && <span class="note">{note}</span>}
  <span class="links">
    {pdf && <a href={pdf}>PDF</a>}
    {website && <a href={website}>Website</a>}
    {code && <a href={code}>Code</a>}
    {links.map((l) => <a href={l.url}>{l.label.charAt(0).toUpperCase() + l.label.slice(1)}</a>)}
    {doi && <a href={doi.startsWith('http') ? doi : `https://doi.org/${doi}`}>DOI</a>}
    <details>
      <summary>BibTeX</summary>
      <pre>{bibtex}</pre>
    </details>
  </span>
</li>

<style>
  .pub { list-style: none; padding: 1rem 0; border-top: 1px solid #ddd; display: flex; flex-direction: column; gap: 0.2rem; }
  .title { font-family: var(--font-head); font-size: 1.15rem; font-weight: 600; }
  .title a { color: var(--ink); }
  .title a:hover { color: var(--purple); }
  .authors, .venue { font-size: 0.95rem; color: #333; }
  .authors a { font-weight: 400; }
  .venue { font-style: italic; }
  .note { font-size: 0.9rem; color: var(--purple); font-weight: 700; }
  .links { display: flex; flex-wrap: wrap; gap: 0 1rem; font-size: 0.85rem; align-items: baseline; }
  details { width: 100%; }
  details summary { display: inline; cursor: pointer; color: var(--orange); font-weight: 700; }
  .links:has(a) details { width: auto; }
  details[open] { width: 100%; }
  pre { background: var(--bg-alt); padding: 0.75rem; font-size: 0.8rem; overflow-x: auto; margin-top: 0.5rem; white-space: pre-wrap; }
</style>
