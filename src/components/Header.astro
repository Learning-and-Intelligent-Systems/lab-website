---
import { url } from '../lib/url';

const links = [
  { href: 'publications/', label: 'Publications' },
  { href: 'people/', label: 'People' },
  { href: 'opportunities/', label: 'Opportunities' },
  { href: 'blog/', label: 'Blog' },
];
const current = Astro.url.pathname;
---

<nav class="primary-nav">
  <div class="wrap nav-inner">
    <a class="logo" href={url('/')} aria-label="Learning & Intelligent Systems home">
      <img class="logo-full" src={url('images/lis-logo.svg')} width="377" height="90" alt="Learning & Intelligent Systems" />
      <img class="logo-small" src={url('images/lis-logo-small.svg')} width="141" height="90" alt="Learning & Intelligent Systems" />
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></label>
    <ul class="nav-links">
      {links.map(({ href, label }) => {
        const full = url(href);
        return (
          <li>
            <a href={full} aria-current={current.startsWith(full) ? 'page' : undefined}>{label}</a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  /* Named so the header stays in place during page transitions while the content cross-fades. */
  .primary-nav { background: var(--navy); position: relative; z-index: 100; view-transition-name: site-header; }
  .nav-inner { display: flex; justify-content: flex-end; align-items: flex-end; min-height: 118px; position: relative; }

  /* The logo hangs below the nav bar, as on the original site. */
  .logo { position: absolute; left: var(--gutter); top: 37px; line-height: 0; }
  .logo img { height: 90px; width: auto; }
  .logo-small { display: none; }

  .nav-links {
    list-style: none;
    display: flex;
    justify-content: space-between;
    flex: 0 1 calc(100% - 377px - 6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.4);
  }
  .nav-links a {
    display: block;
    color: #fff;
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 600;
    border-top: 4px solid transparent;
    padding: 1.25rem 1.5rem 1.5rem;
    text-decoration: none;
  }
  .nav-links a:hover, .nav-links a[aria-current='page'] { border-top-color: #fff; }

  .nav-toggle, .nav-toggle-icon { display: none; }

  @media (max-width: 1100px) {
    .logo-full { display: none; }
    .logo-small { display: block; }
    .nav-links { flex-basis: calc(100% - 141px - 4rem); }
  }

  @media (max-width: 760px) {
    .nav-inner { flex-wrap: wrap; align-items: flex-start; min-height: 64px; }
    .logo { top: 24px; }
    .logo img { height: 64px; }
    .nav-toggle-icon {
      display: flex; flex-direction: column; justify-content: center; gap: 6px;
      width: 44px; height: 64px; cursor: pointer;
    }
    .nav-toggle-icon span { display: block; height: 3px; background: #fff; }
    .nav-links { display: none; flex-direction: column; width: 100%; flex-basis: 100%; border-top: 0; padding: 3.5rem 0 1rem; }
    .nav-toggle:checked ~ .nav-links { display: flex; }
    .nav-links a { padding: 0.75rem 0; border-top: 0; }
    .nav-links a[aria-current='page'] { color: var(--orange); }
  }
</style>
