---
import { getEntries, type CollectionEntry } from 'astro:content';

interface Props {
  authors: CollectionEntry<'blog'>['data']['authors'];
  external?: { name: string; url?: string }[];
}
const { authors, external = [] } = Astro.props;
const people = (await getEntries(authors)).map((p) => ({ name: p.data.name, url: p.data.website }));
const all = [...people, ...external];
---

{all.length > 0 && (
  <span class="authors">
    {all.map((a, i) => (
      <>
        {a.url ? <a href={a.url}>{a.name}</a> : <span>{a.name}</span>}
        {i < all.length - 1 && ', '}
      </>
    ))}
  </span>
)}
